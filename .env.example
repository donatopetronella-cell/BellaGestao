# ---------------------------------------------------------------------------
# BellaGestao - environment variables
# Copy to `.env` and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Runtime connection. MUST be a role WITHOUT BYPASSRLS so Row Level Security
# is enforced for every application query.
DATABASE_URL="postgresql://bella_app:bella_app_dev@127.0.0.1:5432/bellagestao?schema=public"

# Migration / owner connection (prisma migrate, seed). Owns the tables.
DIRECT_DATABASE_URL="postgresql://bella_owner:bella_owner_dev@127.0.0.1:5432/bellagestao?schema=public"

# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session signing key (min 32 chars). Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-development-secret-change-me-please"

# --- Optional integrations (phases 4-6) -----------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET="client-photos"
# OPENAI_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
