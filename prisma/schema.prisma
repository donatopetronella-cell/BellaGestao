// BellaGestao - PostgreSQL schema (multi-tenant SaaS)
// Every tenant-scoped table carries `tenant_id` and is protected by RLS
// (see prisma/migrations/*_rls/migration.sql).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MANAGER
  RECEPTIONIST
  PROFESSIONAL
  FINANCE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum PaymentProvider {
  MERCADO_PAGO
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CHARGEBACK
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_SERVICE
  FINISHED
  CANCELED
  NO_SHOW
}

enum AppointmentSource {
  INTERNAL
  ONLINE
  WHATSAPP
  IMPORT
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  INSTALLMENT
  LOYALTY
  OTHER
}

enum CommissionKind {
  PERCENT
  FIXED
}

enum CommissionTarget {
  SERVICE
  PRODUCT
  ALL
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELED
}

enum FinancialKind {
  REVENUE
  EXPENSE
}

enum FinancialStatus {
  PENDING
  SETTLED
  CANCELED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  IN
  OUT
  WITHDRAWAL
  REINFORCEMENT
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SERVICE_USE
  ADJUSTMENT
  LOSS
  RETURN
  TRANSFER
}

enum SaleItemKind {
  PRODUCT
  SERVICE
}

enum SaleStatus {
  OPEN
  PAID
  CANCELED
}

enum ChemicalProcedure {
  COLORING
  BLEACHING
  PROGRESSIVE
  RELAXING
  BOTOX
  TONING
  RECONSTRUCTION
  OTHER
}

enum PhotoKind {
  BEFORE
  AFTER
  OTHER
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignType {
  REACTIVATION
  BIRTHDAY
  PROMOTION
  REMINDER
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  FINISHED
  CANCELED
}

enum LoyaltyMode {
  POINTS
  CASHBACK
  VISITS
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELED
  LOW_STOCK
  PAYMENT_DUE
  BIRTHDAY
  INACTIVE_CLIENT
  COMMISSION_AVAILABLE
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions               Session[]
  memberships            Membership[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  notifications          Notification[]

  @@map("users")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  activeTenantId String?  @map("active_tenant_id") @db.Uuid
  activeBranchId String?  @map("active_branch_id") @db.Uuid
  ip            String?
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Tenant {
  id                   String       @id @default(uuid(7)) @db.Uuid
  name                 String
  slug                 String       @unique
  legalName            String?      @map("legal_name")
  document             String?
  email                String?
  phone                String?
  whatsapp             String?
  logoUrl              String?      @map("logo_url")
  timezone             String       @default("America/Sao_Paulo")
  currency             String       @default("BRL")
  locale               String       @default("pt-BR")
  status               TenantStatus @default(TRIAL)
  trialEndsAt          DateTime?    @map("trial_ends_at")
  onboardingStep       Int          @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  settings            TenantSettings?
  branches            Branch[]
  memberships         Membership[]
  invitations         Invitation[]
  clients             Client[]
  professionals       Professional[]
  serviceCategories   ServiceCategory[]
  services            Service[]
  appointments        Appointment[]
  hairProfiles        ClientHairProfile[]
  chemicalRecords     ChemicalRecord[]
  hairFormulas        HairFormula[]
  clientPhotos        ClientPhoto[]
  suppliers           Supplier[]
  productCategories   ProductCategory[]
  products            Product[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  sales               Sale[]
  cashRegisters       CashRegister[]
  financialCategories FinancialCategory[]
  revenues            Revenue[]
  expenses            Expense[]
  commissionRules     CommissionRule[]
  commissions         Commission[]
  subscription        Subscription?
  payments            Payment[]
  whatsappTemplates   WhatsappTemplate[]
  whatsappMessages    WhatsappMessage[]
  campaigns           Campaign[]
  loyaltyProgram      LoyaltyProgram?
  loyaltyAccounts     LoyaltyAccount[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  consents            ConsentRecord[]

  @@index([status])
  @@map("tenants")
}

model TenantSettings {
  tenantId                 String   @id @map("tenant_id") @db.Uuid
  appointmentIntervalMin   Int      @default(15) @map("appointment_interval_min")
  cancellationPolicyHours  Int      @default(24) @map("cancellation_policy_hours")
  cancellationPolicyText   String?  @map("cancellation_policy_text")
  onlineBookingEnabled     Boolean  @default(false) @map("online_booking_enabled")
  onlineBookingLeadHours   Int      @default(2) @map("online_booking_lead_hours")
  reminder24hEnabled       Boolean  @default(true) @map("reminder_24h_enabled")
  reminder2hEnabled        Boolean  @default(true) @map("reminder_2h_enabled")
  monthlyRevenueGoal       Decimal? @map("monthly_revenue_goal") @db.Decimal(12, 2)
  extra                    Json     @default("{}")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  slug      String
  phone     String?
  whatsapp  String?
  zipCode   String?   @map("zip_code")
  street    String?
  number    String?
  complement String?
  district  String?
  city      String?
  state     String?
  timezone  String?
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        Membership[]
  clients            Client[]
  appointments       Appointment[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashRegisters      CashRegister[]
  revenues           Revenue[]
  expenses           Expense[]
  workingHours       ProfessionalWorkingHour[]
  openingHours       BranchOpeningHour[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("branches")
}

model BranchOpeningHour {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  weekday   Int
  startMin  Int     @map("start_min")
  endMin    Int     @map("end_min")
  isClosed  Boolean @default(false) @map("is_closed")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday])
  @@index([tenantId])
  @@map("branch_opening_hours")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole
  branchId       String?          @map("branch_id") @db.Uuid
  professionalId String?          @unique @map("professional_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?                    @relation(fields: [branchId], references: [id])
  professional Professional?              @relation(fields: [professionalId], references: [id])
  overrides    MemberPermissionOverride[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  email      String
  role       MemberRole
  branchId   String?    @map("branch_id") @db.Uuid
  tokenHash  String     @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt  DateTime   @map("expires_at")
  acceptedAt DateTime?  @map("accepted_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invitations")
}

/// Global catalog of permissions. Source of truth lives in `src/lib/rbac`,
/// this table mirrors it so custom roles can be built on top later.
model Permission {
  code        String @id
  module      String
  description String

  rolePermissions RolePermission[]
  overrides       MemberPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  role           MemberRole
  permissionCode String     @map("permission_code")

  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([role, permissionCode])
  @@map("role_permissions")
}

model MemberPermissionOverride {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  membershipId   String  @map("membership_id") @db.Uuid
  permissionCode String  @map("permission_code")
  allow          Boolean

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([membershipId, permissionCode])
  @@index([tenantId])
  @@map("member_permission_overrides")
}

// ---------------------------------------------------------------------------
// CRM: clients, hair records, photos
// ---------------------------------------------------------------------------

model Client {
  id                     String       @id @default(uuid(7)) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  branchId               String?      @map("branch_id") @db.Uuid
  name                   String
  phone                  String?
  whatsapp               String?
  email                  String?
  document               String?
  birthDate              DateTime?    @map("birth_date") @db.Date
  zipCode                String?      @map("zip_code")
  street                 String?
  number                 String?
  complement             String?
  district               String?
  city                   String?
  state                  String?
  notes                  String?
  preferences            String?
  allergies              String?
  source                 String?
  status                 ClientStatus @default(ACTIVE)
  preferredProfessionalId String?     @map("preferred_professional_id") @db.Uuid
  marketingConsent       Boolean      @default(false) @map("marketing_consent")
  consentAt              DateTime?    @map("consent_at")
  anonymizedAt           DateTime?    @map("anonymized_at")
  firstVisitAt           DateTime?    @map("first_visit_at")
  lastVisitAt            DateTime?    @map("last_visit_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  deletedAt              DateTime?    @map("deleted_at")

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?           @relation(fields: [branchId], references: [id])
  preferredProfessional Professional?     @relation("PreferredProfessional", fields: [preferredProfessionalId], references: [id])
  appointments          Appointment[]
  hairProfile           ClientHairProfile?
  chemicalRecords       ChemicalRecord[]
  hairFormulas          HairFormula[]
  photos                ClientPhoto[]
  sales                 Sale[]
  loyaltyAccount        LoyaltyAccount?
  whatsappMessages      WhatsappMessage[]
  campaignTargets       CampaignTarget[]
  consents              ConsentRecord[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@index([tenantId, lastVisitAt])
  @@index([tenantId, birthDate])
  @@map("clients")
}

model ClientHairProfile {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  clientId           String   @unique @map("client_id") @db.Uuid
  hairType           String?  @map("hair_type")
  length             String?
  curvature          String?
  texture            String?
  condition          String?
  scalp              String?
  previousProcedures String?  @map("previous_procedures")
  allergies          String?
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("client_hair_profiles")
}

model ChemicalRecord {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  appointmentId  String?           @map("appointment_id") @db.Uuid
  professionalId String?           @map("professional_id") @db.Uuid
  procedure      ChemicalProcedure
  brand          String?
  productName    String?           @map("product_name")
  formula        Json              @default("[]")
  oxidantVolume  Int?              @map("oxidant_volume")
  oxidantMl      Int?              @map("oxidant_ml")
  pauseMinutes   Int?              @map("pause_minutes")
  result         String?
  notes          String?
  performedAt    DateTime          @map("performed_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([tenantId, clientId, performedAt])
  @@map("chemical_history")
}

model HairFormula {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  clientId      String?           @map("client_id") @db.Uuid
  name          String
  procedure     ChemicalProcedure
  brand         String?
  items         Json              @default("[]")
  oxidantVolume Int?              @map("oxidant_volume")
  oxidantMl     Int?              @map("oxidant_ml")
  pauseMinutes  Int?              @map("pause_minutes")
  notes         String?
  isTemplate    Boolean           @default(false) @map("is_template")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@map("hair_formulas")
}

model ClientPhoto {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  appointmentId String?   @map("appointment_id") @db.Uuid
  kind          PhotoKind @default(OTHER)
  storagePath   String    @map("storage_path")
  caption       String?
  takenAt       DateTime  @default(now()) @map("taken_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, clientId, takenAt])
  @@map("client_photos")
}

// ---------------------------------------------------------------------------
// Professionals & catalog
// ---------------------------------------------------------------------------

model Professional {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  phone            String?
  email            String?
  specialty        String?
  photoUrl         String?   @map("photo_url")
  color            String?
  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(5, 2)
  isActive         Boolean   @default(true) @map("is_active")
  hiredAt          DateTime? @map("hired_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership         Membership?
  workingHours       ProfessionalWorkingHour[]
  timeOff            ProfessionalTimeOff[]
  services           ServiceProfessional[]
  appointments       Appointment[]
  appointmentServices AppointmentService[]
  chemicalRecords    ChemicalRecord[]
  preferredByClients Client[]                  @relation("PreferredProfessional")
  sales              Sale[]
  saleItems          SaleItem[]
  commissions        Commission[]
  commissionRules    CommissionRule[]

  @@index([tenantId, isActive])
  @@map("professionals")
}

model ProfessionalWorkingHour {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  professionalId String  @map("professional_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  weekday        Int
  startMin       Int     @map("start_min")
  endMin         Int     @map("end_min")
  breakStartMin  Int?    @map("break_start_min")
  breakEndMin    Int?    @map("break_end_min")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@unique([professionalId, weekday])
  @@index([tenantId])
  @@map("professional_working_hours")
}

model ProfessionalTimeOff {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  reason         String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, startsAt])
  @@map("professional_time_off")
}

model ServiceCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@map("service_categories")
}

model Service {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  categoryId      String?        @map("category_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int            @map("duration_minutes")
  price           Decimal        @db.Decimal(12, 2)
  cost            Decimal        @default(0) @db.Decimal(12, 2)
  commissionKind  CommissionKind @default(PERCENT) @map("commission_kind")
  commissionValue Decimal        @default(0) @map("commission_value") @db.Decimal(12, 2)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            ServiceCategory?      @relation(fields: [categoryId], references: [id])
  professionals       ServiceProfessional[]
  supplies            ServiceSupply[]
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]
  commissionRules     CommissionRule[]

  @@index([tenantId, isActive])
  @@map("services")
}

model ServiceProfessional {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  professionalId  String   @map("professional_id") @db.Uuid
  price           Decimal? @db.Decimal(12, 2)
  durationMinutes Int?     @map("duration_minutes")
  commissionValue Decimal? @map("commission_value") @db.Decimal(12, 2)

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([serviceId, professionalId])
  @@index([tenantId])
  @@map("service_professionals")
}

model ServiceSupply {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@index([tenantId])
  @@map("service_supplies")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  professionalId String            @map("professional_id") @db.Uuid
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(PENDING)
  source         AppointmentSource @default(INTERNAL)
  notes          String?
  total          Decimal           @default(0) @db.Decimal(12, 2)
  discount       Decimal           @default(0) @db.Decimal(12, 2)
  createdById    String?           @map("created_by_id") @db.Uuid
  confirmedAt    DateTime?         @map("confirmed_at")
  arrivedAt      DateTime?         @map("arrived_at")
  startedAt      DateTime?         @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  canceledAt     DateTime?         @map("canceled_at")
  cancelReason   String?           @map("cancel_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch               @relation(fields: [branchId], references: [id])
  client          Client               @relation(fields: [clientId], references: [id])
  professional    Professional         @relation(fields: [professionalId], references: [id])
  services        AppointmentService[]
  chemicalRecords ChemicalRecord[]
  photos          ClientPhoto[]
  sale            Sale?
  commissions     Commission[]
  messages        WhatsappMessage[]

  @@index([tenantId, startsAt])
  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status])
  @@map("appointments")
}

model AppointmentService {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  appointmentId    String  @map("appointment_id") @db.Uuid
  serviceId        String  @map("service_id") @db.Uuid
  professionalId   String  @map("professional_id") @db.Uuid
  price            Decimal @db.Decimal(12, 2)
  durationMinutes  Int     @map("duration_minutes")
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId, appointmentId])
  @@map("appointment_services")
}

// ---------------------------------------------------------------------------
// Inventory & sales
// ---------------------------------------------------------------------------

model Supplier {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  phone    String?
  email    String?
  document String?
  notes    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  expenses Expense[]

  @@index([tenantId])
  @@map("suppliers")
}

model ProductCategory {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  supplierId String?   @map("supplier_id") @db.Uuid
  name       String
  brand      String?
  sku        String?
  barcode    String?
  unit       String    @default("un")
  cost       Decimal   @default(0) @db.Decimal(12, 2)
  price      Decimal   @default(0) @db.Decimal(12, 2)
  minStock   Decimal   @default(0) @map("min_stock") @db.Decimal(12, 3)
  isForSale  Boolean   @default(true) @map("is_for_sale")
  isSupply   Boolean   @default(false) @map("is_supply")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ProductCategory?    @relation(fields: [categoryId], references: [id])
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])
  inventory  InventoryItem[]
  movements  InventoryMovement[]
  saleItems  SaleItem[]
  supplies   ServiceSupply[]
  commissionRules CommissionRule[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

model InventoryItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId])
  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid(7)) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(12, 3)
  unitCost      Decimal?              @map("unit_cost") @db.Decimal(12, 2)
  reason        String?
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  createdById   String?               @map("created_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@map("inventory_movements")
}

model Sale {
  id             String     @id @default(uuid(7)) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  branchId       String     @map("branch_id") @db.Uuid
  clientId       String?    @map("client_id") @db.Uuid
  professionalId String?    @map("professional_id") @db.Uuid
  appointmentId  String?    @unique @map("appointment_id") @db.Uuid
  cashRegisterId String?    @map("cash_register_id") @db.Uuid
  number         Int
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @default(0) @db.Decimal(12, 2)
  status         SaleStatus @default(OPEN)
  soldById       String?    @map("sold_by_id") @db.Uuid
  soldAt         DateTime   @default(now()) @map("sold_at")
  canceledAt     DateTime?  @map("canceled_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  items        SaleItem[]
  payments     SalePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, soldAt])
  @@map("sales")
}

model SaleItem {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  saleId           String       @map("sale_id") @db.Uuid
  kind             SaleItemKind
  productId        String?      @map("product_id") @db.Uuid
  serviceId        String?      @map("service_id") @db.Uuid
  professionalId   String?      @map("professional_id") @db.Uuid
  description      String
  quantity         Decimal      @default(1) @db.Decimal(12, 3)
  unitPrice        Decimal      @map("unit_price") @db.Decimal(12, 2)
  discount         Decimal      @default(0) @db.Decimal(12, 2)
  total            Decimal      @db.Decimal(12, 2)
  commissionAmount Decimal      @default(0) @map("commission_amount") @db.Decimal(12, 2)

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  commissions  Commission[]

  @@index([tenantId, saleId])
  @@map("sale_items")
}

model SalePayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  installments   Int           @default(1)
  cashRegisterId String?       @map("cash_register_id") @db.Uuid
  paidAt         DateTime      @default(now()) @map("paid_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId])
  @@map("sale_payments")
}

// ---------------------------------------------------------------------------
// Cash register & finance
// ---------------------------------------------------------------------------

model CashRegister {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  branchId       String             @map("branch_id") @db.Uuid
  status         CashRegisterStatus @default(OPEN)
  openingAmount  Decimal            @default(0) @map("opening_amount") @db.Decimal(12, 2)
  closingAmount  Decimal?           @map("closing_amount") @db.Decimal(12, 2)
  expectedAmount Decimal?           @map("expected_amount") @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  openedById     String?            @map("opened_by_id") @db.Uuid
  closedById     String?            @map("closed_by_id") @db.Uuid
  openedAt       DateTime           @default(now()) @map("opened_at")
  closedAt       DateTime?          @map("closed_at")
  notes          String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id])
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, branchId, status])
  @@map("cash_registers")
}

model CashMovement {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  cashRegisterId String           @map("cash_register_id") @db.Uuid
  type           CashMovementType
  method         PaymentMethod    @default(CASH)
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  referenceType  String?          @map("reference_type")
  referenceId    String?          @map("reference_id") @db.Uuid
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([tenantId, cashRegisterId])
  @@map("cash_movements")
}

model FinancialCategory {
  id       String        @id @default(uuid(7)) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  name     String
  kind     FinancialKind
  color    String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revenues Revenue[]
  expenses Expense[]

  @@unique([tenantId, kind, name])
  @@map("financial_categories")
}

model Revenue {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  branchId      String?         @map("branch_id") @db.Uuid
  categoryId    String?         @map("category_id") @db.Uuid
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  method        PaymentMethod?
  status        FinancialStatus @default(SETTLED)
  dueDate       DateTime?       @map("due_date") @db.Date
  receivedAt    DateTime?       @map("received_at")
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  category FinancialCategory? @relation(fields: [categoryId], references: [id])

  @@index([tenantId, receivedAt])
  @@map("revenues")
}

model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  branchId    String?         @map("branch_id") @db.Uuid
  categoryId  String?         @map("category_id") @db.Uuid
  supplierId  String?         @map("supplier_id") @db.Uuid
  description String
  amount      Decimal         @db.Decimal(12, 2)
  method      PaymentMethod?
  status      FinancialStatus @default(PENDING)
  dueDate     DateTime?       @map("due_date") @db.Date
  paidAt      DateTime?       @map("paid_at")
  isRecurring Boolean         @default(false) @map("is_recurring")
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?            @relation(fields: [branchId], references: [id])
  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  supplier Supplier?          @relation(fields: [supplierId], references: [id])

  @@index([tenantId, dueDate])
  @@index([tenantId, paidAt])
  @@map("expenses")
}

model CommissionRule {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  professionalId String?          @map("professional_id") @db.Uuid
  serviceId      String?          @map("service_id") @db.Uuid
  productId      String?          @map("product_id") @db.Uuid
  appliesTo      CommissionTarget @default(ALL) @map("applies_to")
  kind           CommissionKind   @default(PERCENT)
  value          Decimal          @db.Decimal(12, 2)
  priority       Int              @default(0)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, priority])
  @@map("commission_rules")
}

model Commission {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  professionalId String           @map("professional_id") @db.Uuid
  appointmentId  String?          @map("appointment_id") @db.Uuid
  saleItemId     String?          @map("sale_item_id") @db.Uuid
  baseAmount     Decimal          @map("base_amount") @db.Decimal(12, 2)
  kind           CommissionKind
  rateValue      Decimal          @map("rate_value") @db.Decimal(12, 2)
  amount         Decimal          @db.Decimal(12, 2)
  status         CommissionStatus @default(PENDING)
  referenceMonth DateTime         @map("reference_month") @db.Date
  paidAt         DateTime?        @map("paid_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  saleItem     SaleItem?    @relation(fields: [saleItemId], references: [id])

  @@index([tenantId, professionalId, referenceMonth])
  @@map("commissions")
}

// ---------------------------------------------------------------------------
// SaaS billing (global tables + tenant subscriptions)
// ---------------------------------------------------------------------------

model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(12, 2)
  priceYearly  Decimal? @map("price_yearly") @db.Decimal(12, 2)
  currency     String   @default("BRL")
  trialDays    Int      @default(14) @map("trial_days")
  features     Json     @default("[]")
  limits       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIAL)
  provider               PaymentProvider    @default(MANUAL)
  providerSubscriptionId String?            @map("provider_subscription_id")
  billingCycle           String             @default("monthly") @map("billing_cycle")
  trialStartsAt          DateTime?          @map("trial_starts_at")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BRL")
  status            PaymentStatus   @default(PENDING)
  method            String?
  paidAt            DateTime?       @map("paid_at")
  payload           Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([tenantId, createdAt])
  @@map("payments")
}

/// Idempotency ledger for billing provider webhooks (global table).
model WebhookEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id")
  type        String
  payload     Json
  processedAt DateTime?       @map("processed_at")
  error       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// WhatsApp, campaigns & loyalty
// ---------------------------------------------------------------------------

model WhatsappTemplate {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  category             String   @default("UTILITY")
  language             String   @default("pt_BR")
  body                 String
  variables            Json     @default("[]")
  providerTemplateName String?  @map("provider_template_name")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  WhatsappMessage[]
  campaigns Campaign[]

  @@unique([tenantId, code])
  @@map("whatsapp_templates")
}

model WhatsappMessage {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  clientId          String?          @map("client_id") @db.Uuid
  appointmentId     String?          @map("appointment_id") @db.Uuid
  campaignId        String?          @map("campaign_id") @db.Uuid
  templateId        String?          @map("template_id") @db.Uuid
  toPhone           String           @map("to_phone")
  direction         MessageDirection @default(OUTBOUND)
  body              String
  status            MessageStatus    @default(QUEUED)
  providerMessageId String?          @map("provider_message_id")
  error             String?
  scheduledAt       DateTime?        @map("scheduled_at")
  sentAt            DateTime?        @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id])
  appointment Appointment?      @relation(fields: [appointmentId], references: [id])
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])
  template    WhatsappTemplate? @relation(fields: [templateId], references: [id])
  targets     CampaignTarget[]

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, clientId])
  @@map("whatsapp_messages")
}

model Campaign {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  type        CampaignType   @default(CUSTOM)
  status      CampaignStatus @default(DRAFT)
  templateId  String?        @map("template_id") @db.Uuid
  filters     Json           @default("{}")
  stats       Json           @default("{}")
  scheduledAt DateTime?      @map("scheduled_at")
  startedAt   DateTime?      @map("started_at")
  finishedAt  DateTime?      @map("finished_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WhatsappTemplate? @relation(fields: [templateId], references: [id])
  targets  CampaignTarget[]
  messages WhatsappMessage[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model CampaignTarget {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  clientId   String  @map("client_id") @db.Uuid
  messageId  String? @map("message_id") @db.Uuid
  status     String  @default("PENDING")

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message  WhatsappMessage? @relation(fields: [messageId], references: [id])

  @@unique([campaignId, clientId])
  @@index([tenantId])
  @@map("campaign_targets")
}

model LoyaltyProgram {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @unique @map("tenant_id") @db.Uuid
  mode              LoyaltyMode @default(POINTS)
  pointsPerCurrency Decimal     @default(1) @map("points_per_currency") @db.Decimal(12, 4)
  currencyPerPoint  Decimal     @default(0.06) @map("currency_per_point") @db.Decimal(12, 4)
  minRedeemPoints   Int         @default(500) @map("min_redeem_points")
  cashbackPercent   Decimal     @default(0) @map("cashback_percent") @db.Decimal(5, 2)
  visitsForReward   Int         @default(10) @map("visits_for_reward")
  rewardDescription String?     @map("reward_description")
  isActive          Boolean     @default(false) @map("is_active")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @unique @map("client_id") @db.Uuid
  pointsBalance   Int      @default(0) @map("points_balance")
  cashbackBalance Decimal  @default(0) @map("cashback_balance") @db.Decimal(12, 2)
  visits          Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([tenantId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id            String                 @id @default(uuid(7)) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  accountId     String                 @map("account_id") @db.Uuid
  type          LoyaltyTransactionType
  points        Int                    @default(0)
  amount        Decimal                @default(0) @db.Decimal(12, 2)
  description   String?
  referenceType String?                @map("reference_type")
  referenceId   String?                @map("reference_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId, createdAt])
  @@map("loyalty_transactions")
}

// ---------------------------------------------------------------------------
// Platform: notifications, audit, LGPD
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  userName  String?  @map("user_name")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   String?
  changes   Json     @default("{}")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

model ConsentRecord {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  clientId  String?   @map("client_id") @db.Uuid
  type      String
  granted   Boolean
  source    String?
  ip        String?
  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@map("consent_records")
}
